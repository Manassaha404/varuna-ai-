{
	servers {
		trusted_proxies static private_ranges
	}
}

:80 {
	handle /auth/* {
		header Cache-Control "no-store, must-revalidate"
		reverse_proxy api:8000
	}

	handle /api/* {
		header Cache-Control "no-store, must-revalidate"
		reverse_proxy api:8000
	}

	handle /trpc/* {
		header Cache-Control "no-store, must-revalidate"
		reverse_proxy api:8000
	}

	handle /socket.io/* {
		# Caddy automatically handles WebSocket upgrades
		reverse_proxy socket:8080
	}

	handle /_next/static/* {
		header Cache-Control "public, max-age=31536000, immutable"
		reverse_proxy web:3000
	}

	handle {
		# Everything else is a page/document - never cache these, or
		# you'll keep seeing the old build after a deploy even though
		# the web container was recreated with the new image.
		header Cache-Control "no-store, must-revalidate"
		reverse_proxy web:3000
	}
}
